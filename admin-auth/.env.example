NODE_ENV=production
PORT=3000

# Long random secret; keep this outside GitHub.
SESSION_SECRET=replace-with-a-long-random-secret

# The single authorized MELO admin account.
ADMIN_EMAIL=admin@example.com
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=REPLACE_ME_WITH_ARGON2ID_HASH

# Redis session store. Never commit real credentials.
REDIS_URL=redis://username:password@host:6379

# Exact public origin serving the admin login, e.g. https://admin.example.com
ADMIN_ALLOWED_ORIGIN=https://admin.example.com
